# DarMeuble backend — variables d'environnement
#
# Noms uniquement, jamais de valeur réelle dans ce fichier ni dans aucun
# commit — voir docs/backend/coding-rules-backend.md du kit de démarrage.

NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=

# Access court + refresh opaque avec rotation — voir docs/backend/adr/0004-*.md
# du kit de démarrage.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=darmeuble_refresh_token

# OTP locataire (téléphone + code SMS) — voir docs/backend/socle-backend.md §5.
OTP_TTL_SECONDS=300
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Djomy — noms de variables à confirmer contre la documentation technique
# réelle (voir docs/backend/paiements-djomy.md §"Hypothèse à vérifier en
# premier"). Placeholders de départ, pas un contrat vérifié. Non consommés
# tant que PAYMENT_PROVIDER=mock.
PAYMENT_PROVIDER=mock
DJOMY_API_KEY=
DJOMY_MERCHANT_ID=
DJOMY_WEBHOOK_SECRET=

# Fournisseur SMS — non choisi (docs/backend/socle-backend.md §0bis).
# SMS_PROVIDER=console tant qu'aucun fournisseur n'est intégré : le code OTP
# est journalisé (DEV ONLY), jamais réellement envoyé.
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=

# CORS
FRONTEND_URL=http://localhost:3010

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Seed (prisma/seed.ts) — création du premier compte super_admin. À exécuter
# une seule fois par environnement, jamais via un endpoint HTTP public.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
